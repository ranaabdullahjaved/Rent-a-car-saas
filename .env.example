# Database
# - Local dev / the standalone worker process: DATABASE_URL and
#   DATABASE_URL_UNPOOLED can both be the direct connection, DEPLOYMENT=server.
# - Vercel (serverless): DATABASE_URL must be Supabase's POOLER connection
#   (port 6543, Supabase dashboard -> Project Settings -> Database ->
#   Connection Pooling) so concurrent function invocations don't exhaust
#   Postgres connections. DATABASE_URL_UNPOOLED stays the direct connection
#   (port 5432) -- migrations need a real session, which PgBouncer's
#   transaction-pooling mode doesn't support. Set DEPLOYMENT=serverless.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SSL=true
DEPLOYMENT=server

# Better Auth
# On Vercel, BETTER_AUTH_URL must be your production domain (not localhost).
# Preview deployments are covered automatically via Vercel's VERCEL_URL env
# var, wired into trustedOrigins in src/lib/auth/server.ts.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Redis (for BullMQ)
REDIS_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# App
# On Vercel, set this to your production domain too (used client-side by
# lib/auth/client.ts as the auth base URL).
NEXT_PUBLIC_APP_URL=
NODE_ENV=development
