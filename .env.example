# Database
# - Local dev / the standalone worker process: DATABASE_URL and
#   DATABASE_URL_UNPOOLED can both be the direct connection, DEPLOYMENT=server.
# - Vercel (serverless): DATABASE_URL must be Supabase's POOLER connection
#   (port 6543, Supabase dashboard -> Project Settings -> Database ->
#   Connection Pooling) so concurrent function invocations don't exhaust
#   Postgres connections. DATABASE_URL_UNPOOLED stays the direct connection
#   (port 5432) -- migrations need a real session, which PgBouncer's
#   transaction-pooling mode doesn't support. Set DEPLOYMENT=serverless.
#
# NOT optional on Vercel. Supabase's direct host db.<ref>.supabase.co
# publishes an AAAA record only, and Vercel's runtime has no IPv6 egress, so
# it fails to resolve entirely -- not just under load. The pooler host is
# IPv4. Shape of the pooler URL (note the user is postgres.<project-ref>):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# db/client.ts detects port 6543 / a "pooler" hostname and turns OFF
# prepared statements, which transaction-mode pooling cannot support.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SSL=true
DEPLOYMENT=server

# Better Auth
# On Vercel, BETTER_AUTH_URL must be your production domain (not localhost).
# Preview deployments are covered automatically via Vercel's VERCEL_URL env
# var, wired into trustedOrigins in src/lib/auth/server.ts.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Redis (for BullMQ)
REDIS_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# App
# On Vercel, set this to your production domain too (used client-side by
# lib/auth/client.ts as the auth base URL).
NEXT_PUBLIC_APP_URL=

# NODE_ENV is deliberately not set here. Next.js sets it itself per command
# (development for `next dev`, production for `next build`/`next start`), and
# overriding it makes a production build run with development semantics and
# emits a "non-standard NODE_ENV" warning. Do not set it in Vercel either.
